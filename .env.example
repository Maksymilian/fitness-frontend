# Where the dev server (pnpm dev) and the preview server (pnpm preview) forward /api/<service>/.
# Defaults: the services' ports in fitness-backend's apps/<service>/.env.example.
WORKOUT_TRACKING_URL=http://localhost:3001
TRAINING_PROGRESS_URL=http://localhost:3002
BILLING_URL=http://localhost:3003

# Where the browser sends each service's requests. Defaults: /api/<service>, through the proxy
# above. To call Training Progress or Billing directly instead, set its URL here and add this app's
# origin to the service's CORS_ORIGINS. Workout Tracking has no CORS: keep it behind the proxy.
# VITE_TRAINING_PROGRESS_URL=http://localhost:3002
# VITE_BILLING_URL=http://localhost:3003
